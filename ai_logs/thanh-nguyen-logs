1. SQL Schema (DDL)
Bạn nên chạy script này trong database (MySQL/PostgreSQL) trước khi nạp dữ liệu từ CSV.

SQL
-- 1. Customers
CREATE TABLE customers (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    email VARCHAR(100),
    latitude DOUBLE,
    longitude DOUBLE
);

-- 2. Restaurants
CREATE TABLE restaurants (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    address VARCHAR(255),
    rating DOUBLE
);

-- 3. MenuItems (Có version để xử lý Race Condition kho hàng)
CREATE TABLE menu_items (
    id INT PRIMARY KEY,
    restaurant_id INT,
    item_name VARCHAR(100),
    price DOUBLE,
    stock_qty INT,
    version INT DEFAULT 0,
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(id)
);

-- 4. Drivers (Có version để xử lý Race Condition gán đơn)
CREATE TABLE drivers (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    status VARCHAR(20), -- AVAILABLE, BUSY
    current_lat DOUBLE,
    current_lng DOUBLE,
    version INT DEFAULT 0
);

-- 5. Orders (Có version để tránh Double Assignment)
CREATE TABLE orders (
    id INT PRIMARY KEY,
    customer_id INT,
    driver_id INT,
    total_price DOUBLE,
    status VARCHAR(20), -- PENDING, ASSIGNED, DELIVERED
    version INT DEFAULT 0,
    FOREIGN KEY (customer_id) REFERENCES customers(id),
    FOREIGN KEY (driver_id) REFERENCES drivers(id)
);

-- 6. OrderItems
CREATE TABLE order_items (
    id INT PRIMARY KEY,
    order_id INT,
    menu_item_id INT,
    quantity INT,
    price_at_time DOUBLE,
    FOREIGN KEY (order_id) REFERENCES orders(id),
    FOREIGN KEY (menu_item_id) REFERENCES menu_items(id)
);

-- 7. DeliveryRoutes
CREATE TABLE delivery_routes (
    id INT PRIMARY KEY,
    order_id INT,
    distance_km DOUBLE,
    estimated_time_min INT,
    FOREIGN KEY (order_id) REFERENCES orders(id)
);
